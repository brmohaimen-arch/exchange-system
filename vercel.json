{
  "builds": [
    { "src": "main.py", "use": "@vercel/python" }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "main.py" }
  ],
  "crons": [
    { "path": "/api/cron/notifications", "schedule": "0 6 * * *" },
    { "path": "/api/cron/backup", "schedule": "0 2 * * *" },
    { "path": "/api/cron/whatsapp-summary", "schedule": "0 18 * * *" },
    { "path": "/api/cron/trial-check", "schedule": "0 3 * * *" }
  ]
}
